  m_Script: {fileID: 11500000, guid: d80aa231c1dafd04487c1efa43ee3e58, type: 3}
  m_Name: 
  m_EditorClassIdentifier: BoatGame.Presentation.BoatLevelUI::BoatGame.Presentation.BoatLevelUI.DialoguePanel
  _text: {fileID: 1647993340}
  _tapArea: {fileID: 1802318523}
  _continueHint: {fileID: 1485505627}
  _charactersPerSecond: 30
  _lines:
  - Text: Hello, little traveler! Welcome to our village by the great Nile.
    Voice: {fileID: 8300000, guid: 904fb365bb2c6e5488c16168ca46fce1, type: 3}
  - Text: Take the boat and travel to <b>Rawda Island</b>!
    Voice: {fileID: 8300000, guid: 08472cc4ba642d74e943f151aa2db712, type: 3}
  - Text: Watch out for rocks and little islands, and grab the gold coins if you can!
    Voice: {fileID: 8300000, guid: ae81830fe3e9cd149a5873da7d550f93, type: 3}
