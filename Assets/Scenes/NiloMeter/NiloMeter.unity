      - m_Target: {fileID: 2114526892}
        m_TargetAssemblyTypeName: WaterAnimator, Assembly-CSharp
        m_MethodName: AnimateYSizeAndReturn
        m_Mode: 4
        m_Arguments:
          m_ObjectArgument: {fileID: 0}
          m_ObjectArgumentAssemblyTypeName: UnityEngine.Object, UnityEngine
          m_IntArgument: 0
          m_FloatArgument: -11
          m_StringArgument: 
          m_BoolArgument: 0
        m_CallState: 2
  _dialogue: {fileID: 550020042}
  _introLines:
  - Text: Welcome to the <b>Nilometer</b>, little traveler!
    Voice: {fileID: 8300000, guid: 6a471fa7aeb8e6f4d898786b9a2fb0c9, type: 3}
  - Text: Every summer the great Nile floods... and the water climbs up these steps.
    Voice: {fileID: 8300000, guid: 38c8ff5121e606a4e9573d0b844f1488, type: 3}
  - Text: Look at the tall column. Each number shows how high the water is.
    Voice: {fileID: 8300000, guid: 5f9254463df3a3140a5964b5472d247f, type: 3}
  _introMoods: 020000000400000001000000i
  _askLines:
  - Text: How high is the water?
    Voice: {fileID: 8300000, guid: 95664c97cc761f541a0bfaf1b905635f, type: 3}
  - Text: The water is rising! How high is it now?
    Voice: {fileID: 8300000, guid: 0cec1f3e7ac58c742b6d3788125d54f0, type: 3}
  _correctLines:
  - Text: Great job! The water is <b>zero</b> cubits high!
    Voice: {fileID: 0}
  - Text: Great job! The water is <b>one</b> cubits high!
    Voice: {fileID: 0}
  - Text: Great job! The water is <b>two</b> cubits high!
    Voice: {fileID: 8300000, guid: c16ea1c431802c7429d7d907f0e00f45, type: 3}
  - Text: Great job! The water is <b>three</b> cubits high!
    Voice: {fileID: 8300000, guid: c7a782b3e2c750946bb096af1cea16fb, type: 3}
  - Text: Great job! The water is <b>four</b> cubits high!
    Voice: {fileID: 8300000, guid: 81c0be53ec106ce4eb07cee4d09521ba, type: 3}
  - Text: Great job! The water is <b>five</b> cubits high!
    Voice: {fileID: 8300000, guid: d209580ea31c0da4090c56ff62f3fd81, type: 3}
  - Text: Great job! The water is <b>six</b> cubits high!
    Voice: {fileID: 8300000, guid: aafb7b0e72b457b4680ff8c8280a03e0, type: 3}
  - Text: Great job! The water is <b>seven</b> cubits high!
    Voice: {fileID: 0}
  - Text: Great job! The water is <b>eight</b> cubits high!
    Voice: {fileID: 8300000, guid: 81c0be53ec106ce4eb07cee4d09521ba, type: 3}
  - Text: Great job! The water is <b>nine</b> cubits high!
    Voice: {fileID: 8300000, guid: 02418dbfe4bd53246b9b375322da800c, type: 3}
  - Text: Great job! The water is <b>ten</b> cubits high!
    Voice: {fileID: 0}
  _almostLine:
    Text: Almost! Look carefully at the water level.
    Voice: {fileID: 8300000, guid: 7af339c7fded21d419c308dc2801da41, type: 3}
  _sorryLine:
    Text: I'm sorry, little one. Look... the water is right here.
    Voice: {fileID: 8300000, guid: 78529993da6273549ba3a06f5b678df8, type: 3}
  _hintLines:
  - Text: Look where the water touches the column.
    Voice: {fileID: 8300000, guid: b2bd3881170120a4ea8754beae938e54, type: 3}
  - Text: Find the number right at the top of the water.
    Voice: {fileID: 8300000, guid: 0bc48e8d13bae2a4a8f03e2827865598, type: 3}
  _lessonLines:
  - Text: This is called a <b>Nilometer</b>. People used Nilometers to measure the level of the Nile.
    Voice: {fileID: 8300000, guid: c36622344c50990429ad0b3f37918aaa, type: 3}
  - Text: When the water was high, the farmers knew their fields would be green!
    Voice: {fileID: 8300000, guid: 92da592e4d954144a8c37249e019a876, type: 3}
  _lessonMoods: 0400000002000000i
  _cubitLines:
  - Text: A <b>cubit</b> was an old unit of measurement.
    Voice: {fileID: 8300000, guid: e93120122e6e1214889e699f154db0c4, type: 3}
  - Text: It was based on the distance from the elbow to the end of the hand.
    Voice: {fileID: 8300000, guid: ec3111d397fda704185c4994544af2ea, type: 3}
  - Text: Each mark on the Nilometer is one cubit!
    Voice: {fileID: 8300000, guid: 3e98e0e417ebbf2478d32cd317f21731, type: 3}
  - Text: You measured the Nile like a real Egyptian. Well done!
    Voice: {fileID: 8300000, guid: f4e9c2d79f0f9f243a65b0c267b7975c, type: 3}
  _cubitMoods: 04000000040000000100000002000000i
  _hintButton: {fileID: 1655509861}
  _waterAnimationDelayAfterVoiceStarts: 1
  _correctAnswerFeedbackDuration: 3
  _playerAvatarSelector: {fileID: 229899071}
  _elder: {fileID: 1289869629}
  _boy: {fileID: 2060520894171861810}
  _girl: {fileID: 2060520894171861809}
  _lessonBanner: {fileID: 628823189}
  _cubitCard: {fileID: 2031692829}
